# Шаблон переменных окружения.
# Скопируйте файл в `.env` и заполните значения:
#   cp example.env .env
# Файл `.env` добавлен в `.gitignore` — он НЕ должен попадать в git.

# --- Группа DeepSeek (модель для генерации HTML) ---
# Ключ обязателен. Получить: https://platform.deepseek.com/api_keys
DEEPSEEK__API_KEY=
DEEPSEEK__MAX_CONNECTIONS=5
DEEPSEEK__TIMEOUT=120
# Необязательно: базовый URL совместимого провайдера (например, https://api.vsegpt.ru/v1)
DEEPSEEK__BASE_URL=
# Необязательно: имя модели (по умолчанию deepseek-chat)
DEEPSEEK__MODEL=

# --- Группа Unsplash (поиск изображений) ---
# Access Key обязателен. Получить: https://unsplash.com/developers
UNSPLASH__API_KEY=
UNSPLASH__MAX_CONNECTIONS=5
UNSPLASH__TIMEOUT=20
# Необязательно: HTTP-прокси для запросов к Unsplash (удобно при гео-блоке)
UNSPLASH__PROXY=

# --- Группа S3 (хранилище сгенерированных сайтов) ---
# Адрес S3-совместимого API (для локального MinIO: http://localhost:9000)
S3__ENDPOINT_URL=http://localhost:9000
# AWS Access Key — соответствует MINIO_ROOT_USER в /etc/minio/config.env
S3__ACCESS_KEY_ID=
# AWS Secret Key — соответствует MINIO_ROOT_PASSWORD в /etc/minio/config.env
S3__SECRET_ACCESS_KEY=
# Имя бакета — должно совпадать с бакетом, созданным в веб-интерфейсе MinIO
S3__BUCKET_NAME=fastai-sites
# Регион S3 (необязателен, по умолчанию us-east-1)
S3__REGION_NAME=us-east-1
# Необязательно: таймаут подключения к S3, сек (пусто — дефолт botocore)
S3__CONNECT_TIMEOUT=5
# Необязательно: таймаут чтения, сек (пусто — дефолт botocore)
S3__READ_TIMEOUT=60
# Необязательно: лимит одновременных подключений (пусто — дефолт botocore)
S3__MAX_POOL_CONNECTIONS=10

# --- Приложение ---
DEBUG=false
